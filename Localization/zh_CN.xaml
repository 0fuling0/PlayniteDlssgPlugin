<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Common -->
    <sys:String x:Key="LocDlssgTitle">DLSSG SM86</sys:String>
    <sys:String x:Key="LocDlssgNoDeployGames">没有可部署的游戏</sys:String>
    <sys:String x:Key="LocDlssgNoUninstallGames">没有可卸载的游戏</sys:String>
    <sys:String x:Key="LocDlssgSourceMissing">源文件不存在，请在设置中检查源目录和文件名&#10;&#10;DLL: {0}</sys:String>
    <sys:String x:Key="LocDlssgIniLine">INI: {0}</sys:String>
    <sys:String x:Key="LocDlssgNotFound">未找到</sys:String>
    <sys:String x:Key="LocDlssgDeployConfirm">将向 {0} 个游戏释放 DLSSG 文件，并覆盖目标中的同名文件。是否继续？</sys:String>
    <sys:String x:Key="LocDlssgDeployProgress">正在部署 DLSSG 文件...</sys:String>
    <sys:String x:Key="LocDlssgDeployResultTitle">DLSSG SM86 部署结果</sys:String>
    <sys:String x:Key="LocDlssgUninstallConfirm">将从 {0} 个游戏中移除之前释放的 DLSSG 文件。是否继续？</sys:String>
    <sys:String x:Key="LocDlssgUninstallProgress">正在移除 DLSSG 文件...</sys:String>
    <sys:String x:Key="LocDlssgUninstallResultTitle">DLSSG SM86 卸载结果</sys:String>
    <sys:String x:Key="LocDlssgFailNoInstallDir">没有有效的安装目录</sys:String>
    <sys:String x:Key="LocDlssgFailNoTargetDir">未找到包含 nvngx_dlssg.dll 的目录</sys:String>
    <sys:String x:Key="LocDlssgFailNoDeployedFiles">未找到之前释放的 DLSSG 文件</sys:String>

    <!-- Result summary -->
    <sys:String x:Key="LocDlssgSummarySucceededGames">成功处理游戏: {0}</sys:String>
    <sys:String x:Key="LocDlssgSummaryFailedGames">失败游戏: {0}</sys:String>
    <sys:String x:Key="LocDlssgSummaryDirsDeploy">成功处理目标目录: {0}</sys:String>
    <sys:String x:Key="LocDlssgSummaryDirsUninstall">清理的目标目录: {0}</sys:String>
    <sys:String x:Key="LocDlssgSummaryDeletedFiles">已删除文件: {0}</sys:String>
    <sys:String x:Key="LocDlssgSummaryCancelled">操作已取消</sys:String>
    <sys:String x:Key="LocDlssgSummarySuccessHeader">=== 成功 ===</sys:String>
    <sys:String x:Key="LocDlssgSummaryFailHeader">=== 失败 ===</sys:String>
    <sys:String x:Key="LocDlssgSummaryMore">（其余 {0} 项未显示）</sys:String>

    <!-- Menus -->
    <sys:String x:Key="LocDlssgMenuConfigure">配置 Playnite DLSSG 插件</sys:String>
    <sys:String x:Key="LocDlssgMenuDeployFiltered">释放到当前筛选游戏</sys:String>
    <sys:String x:Key="LocDlssgMenuDeploySelected">释放到当前选中游戏</sys:String>
    <sys:String x:Key="LocDlssgMenuDeployAll">释放到全部游戏</sys:String>
    <sys:String x:Key="LocDlssgGameDeploy">释放 DLSSG 文件</sys:String>
    <sys:String x:Key="LocDlssgMenuUninstallFiltered">从当前筛选游戏卸载</sys:String>
    <sys:String x:Key="LocDlssgMenuUninstallSelected">从当前选中游戏卸载</sys:String>
    <sys:String x:Key="LocDlssgMenuUninstallAll">从全部游戏卸载</sys:String>
    <sys:String x:Key="LocDlssgGameUninstall">卸载 DLSSG 文件</sys:String>
    <sys:String x:Key="LocDlssgSidebarTitle">DLSSG 设置</sys:String>

    <!-- Settings view -->
    <sys:String x:Key="LocDlssgSettingsTitle">Playnite DLSSG Plugin 配置</sys:String>
    <sys:String x:Key="LocDlssgSettingsSubtitle">本插件释放的文件来自 https://github.com/sdli1995/dlssg_for_sm86</sys:String>

    <sys:String x:Key="LocDlssgCardDeploy">释放与卸载操作</sys:String>
    <sys:String x:Key="LocDlssgScopeLabel">默认释放范围</sys:String>
    <sys:String x:Key="LocDlssgScopeDesc">选择点击下方释放/卸载按钮时默认处理的游戏范围</sys:String>
    <sys:String x:Key="LocDlssgScopeFiltered">当前筛选结果</sys:String>
    <sys:String x:Key="LocDlssgScopeSelected">当前选中游戏</sys:String>
    <sys:String x:Key="LocDlssgScopeAll">全部游戏</sys:String>
    <sys:String x:Key="LocDlssgScopeHelp">当前筛选结果=列表筛选后；当前选中游戏=手动选中；全部游戏=整个库</sys:String>
    <sys:String x:Key="LocDlssgBtnDeploy">释放文件</sys:String>
    <sys:String x:Key="LocDlssgBtnDeployTip">使用当前配置释放 DLL / INI 文件到目标游戏目录</sys:String>
    <sys:String x:Key="LocDlssgBtnDeployDesc">点击上方按钮将按当前配置释放文件到目标游戏目录</sys:String>
    <sys:String x:Key="LocDlssgBtnUninstall">卸载文件</sys:String>
    <sys:String x:Key="LocDlssgBtnUninstallTip">从目标游戏目录移除之前释放的 DLL / INI 文件</sys:String>
    <sys:String x:Key="LocDlssgBtnUninstallDesc">点击上方按钮将从目标游戏目录移除之前释放的文件</sys:String>

    <sys:String x:Key="LocDlssgCardIni">自定义 INI 配置</sys:String>
    <sys:String x:Key="LocDlssgChkCustomIni">使用自定义 INI 内容（下方选项生成)</sys:String>
    <sys:String x:Key="LocDlssgChkCustomIniTip">启用后，插件会根据下方选项自动生成 INI 内容；禁用则直接复制源目录下选定的 INI 文件</sys:String>
    <sys:String x:Key="LocDlssgKernelLabel">KernelImage（内核镜像模式）</sys:String>
    <sys:String x:Key="LocDlssgKernelDesc">PTX=驱动JIT编译(兼容性最好)；Cubin=预编译二进制(需精确匹配GPU)；Auto=自动选择</sys:String>
    <sys:String x:Key="LocDlssgKernelTip">PTX=驱动JIT编译(兼容性最好)；Cubin=预编译二进制；Auto=自动选择</sys:String>
    <sys:String x:Key="LocDlssgBilinearLabel">HardwareBilinear（硬件双线性过滤）</sys:String>
    <sys:String x:Key="LocDlssgBilinearDesc">0=关闭(精确输出，默认)；1=开启(近似采样，仅SM86/Ampere支持)</sys:String>
    <sys:String x:Key="LocDlssgBilinearTip">0=精确输出(默认)；1=硬件近似双线性过滤，仅SM86支持</sys:String>
    <sys:String x:Key="LocDlssgMaxFramesLabel">MaxGeneratedFrames（最大生成帧数）</sys:String>
    <sys:String x:Key="LocDlssgMaxFramesDesc">1=2X帧生成；2=3X；3=4X；5=6X(上限，实际倍率由游戏决定)</sys:String>
    <sys:String x:Key="LocDlssgMaxFramesTip">帧生成倍率上限：1=2倍，2=3倍，3=4倍，5=6倍</sys:String>
    <sys:String x:Key="LocDlssgLogLevelLabel">LogLevel（日志等级）</sys:String>
    <sys:String x:Key="LocDlssgLogLevelDesc">0=关闭 1=仅错误 2=诊断信息 3=详细调试</sys:String>
    <sys:String x:Key="LocDlssgLogLevelTip">0=关闭 1=仅错误 2=诊断信息 3=详细调试</sys:String>

    <sys:String x:Key="LocDlssgCardPaths">文件路径设置</sys:String>
    <sys:String x:Key="LocDlssgSourceDirLabel">源目录</sys:String>
    <sys:String x:Key="LocDlssgSourceDirDesc">DLSSG 文件所在文件夹（留空则使用插件内置资源）</sys:String>
    <sys:String x:Key="LocDlssgBtnBrowse">浏览...</sys:String>
    <sys:String x:Key="LocDlssgBtnBrowseTip">选择包含 DLL 和 INI 文件的文件夹</sys:String>
    <sys:String x:Key="LocDlssgPathPlaceholder">输入或选择路径</sys:String>
    <sys:String x:Key="LocDlssgSourceDllHelp">DLL来源：内置资源根目录(version.dll) 或 alternatives文件夹(dinput8/dxgi/dbghelp/d3d12/winmm.dll)</sys:String>
    <sys:String x:Key="LocDlssgSourceIniHelp">INI来源：内置的 dlssg_sm86.ini；设置了来源目录时使用该目录下的 dlssg_sm86.ini</sys:String>
    <sys:String x:Key="LocDlssgDllLabel">DLL 文件</sys:String>
    <sys:String x:Key="LocDlssgDllDesc">选择要部署的 DLL 代理文件</sys:String>
    <sys:String x:Key="LocDlssgDllTip">可选：version.dll(根目录)、dinput8.dll、dxgi.dll、dbghelp.dll、d3d12.dll、winmm.dll(alternatives文件夹)</sys:String>
    <sys:String x:Key="LocDlssgDllHelp">version.dll为标准代理；其余为替代注入方式</sys:String>
    <sys:String x:Key="LocDlssgIniLabel">INI 文件</sys:String>
    <sys:String x:Key="LocDlssgIniDesc">选择要部署的 INI 配置文件</sys:String>
    <sys:String x:Key="LocDlssgIniTip">使用内置或来源目录中的 dlssg_sm86.ini</sys:String>
    <sys:String x:Key="LocDlssgIniHelp">dlssg_sm86.ini为出厂配置；内核族会根据显卡自动选择</sys:String>
    <sys:String x:Key="LocDlssgBrowseDialog">选择 DLSSG 文件所在文件夹</sys:String>

    <!-- Settings validation -->
    <sys:String x:Key="LocDlssgErrSourceMissing">源目录不存在</sys:String>
    <sys:String x:Key="LocDlssgErrDllInvalid">DLL 文件 无效</sys:String>
    <sys:String x:Key="LocDlssgErrIniInvalid">INI 文件 无效</sys:String>
    <sys:String x:Key="LocDlssgErrKernel">KernelImage 必须是 PTX、Cubin 或 Auto</sys:String>
    <sys:String x:Key="LocDlssgErrBilinear">HardwareBilinear 必须是 0 或 1</sys:String>
    <sys:String x:Key="LocDlssgErrMaxFrames">MaxGeneratedFrames 必须在 1 到 5 之间</sys:String>
    <sys:String x:Key="LocDlssgErrLogLevel">LogLevel 必须在 0 到 3 之间</sys:String>
    <sys:String x:Key="LocDlssgErrScope">释放范围无效</sys:String>
    <sys:String x:Key="LocDlssgErrCustomIni">启用自定义 INI 时，内容不能为空</sys:String>
</ResourceDictionary>
