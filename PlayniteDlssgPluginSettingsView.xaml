<UserControl x:Class="PlayniteDlssgPluginSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlayniteDlssgPlugin"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="600"
             Name="SettingsView">
    <UserControl.Resources>
        <local:WidthToItemWidthConverter x:Key="WidthToItemWidthConverter"/>

        <Style x:Key="PlaceholderTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                <VisualBrush.Visual>
                                    <TextBlock Text="{DynamicResource LocDlssgPathPlaceholder}" Foreground="Gray" Margin="4,0,0,0" FontSize="13"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                <VisualBrush.Visual>
                                    <TextBlock Text="{DynamicResource LocDlssgPathPlaceholder}" Foreground="Gray" Margin="4,0,0,0" FontSize="13"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextBoxLikeCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,10,12,12"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="MaxWidth" Value="500"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        </Style>

        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="NormalBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  Name="MainScrollViewer">
        <StackPanel Margin="4">
            <StackPanel Margin="4,0,4,8">
                <TextBlock FontSize="{DynamicResource FontSizeLarger}" FontWeight="Bold" Text="{DynamicResource LocDlssgSettingsTitle}"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7"
                           Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSizeSmall}"
                           Text="{DynamicResource LocDlssgSettingsSubtitle}"/>
            </StackPanel>

            <WrapPanel x:Name="CardsPanel"
                       Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       ItemWidth="{Binding ElementName=MainScrollViewer, Path=ActualWidth, Converter={StaticResource WidthToItemWidthConverter}}">

                <Border Style="{StaticResource TextBoxLikeCardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource LocDlssgCardDeploy}"/>

                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LocDlssgScopeLabel}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource LocDlssgScopeDesc}"/>
                            <ComboBox Style="{StaticResource ComboStyle}"
                                      SelectedValue="{Binding Settings.ReleaseScope, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      ToolTip="{DynamicResource LocDlssgScopeHelp}">
                                <ComboBoxItem Content="{DynamicResource LocDlssgScopeFiltered}" Tag="Filtered"/>
                                <ComboBoxItem Content="{DynamicResource LocDlssgScopeSelected}" Tag="Selected"/>
                                <ComboBoxItem Content="{DynamicResource LocDlssgScopeAll}" Tag="All"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource SettingDesc}" Margin="0,3,0,0"
                                       Text="{DynamicResource LocDlssgScopeHelp}"/>
                        </StackPanel>

                        <Button Style="{StaticResource NormalBtn}" Content="{DynamicResource LocDlssgBtnDeploy}"
                                Command="{Binding ReleaseByConfigCommand}"
                                ToolTip="{DynamicResource LocDlssgBtnDeployTip}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,3,0,0"
                                   Text="{DynamicResource LocDlssgBtnDeployDesc}"/>
                        <Button Style="{StaticResource NormalBtn}" Content="{DynamicResource LocDlssgBtnUninstall}"
                                Command="{Binding UninstallByConfigCommand}"
                                ToolTip="{DynamicResource LocDlssgBtnUninstallTip}"/>
                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,3,0,0"
                                   Text="{DynamicResource LocDlssgBtnUninstallDesc}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TextBoxLikeCardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource LocDlssgCardIni}"/>

                        <CheckBox Style="{StaticResource CheckStyle}" Content="{DynamicResource LocDlssgChkCustomIni}"
                                  IsChecked="{Binding Settings.UseCustomIni, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{DynamicResource LocDlssgChkCustomIniTip}"/>

                        <StackPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LocDlssgKernelLabel}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource LocDlssgKernelDesc}"/>
                                <ComboBox Style="{StaticResource ComboStyle}"
                                          SelectedValue="{Binding Settings.KernelImage, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          ToolTip="{DynamicResource LocDlssgKernelTip}">
                                    <ComboBoxItem Content="PTX"/>
                                    <ComboBoxItem Content="Cubin"/>
                                    <ComboBoxItem Content="Auto"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LocDlssgBilinearLabel}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource LocDlssgBilinearDesc}"/>
                                <ComboBox Style="{StaticResource ComboStyle}"
                                          SelectedValue="{Binding Settings.HardwareBilinear, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          ToolTip="{DynamicResource LocDlssgBilinearTip}">
                                    <ComboBoxItem Content="0"/>
                                    <ComboBoxItem Content="1"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LocDlssgMaxFramesLabel}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource LocDlssgMaxFramesDesc}"/>
                                <ComboBox Style="{StaticResource ComboStyle}"
                                          SelectedValue="{Binding Settings.MaxGeneratedFrames, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          ToolTip="{DynamicResource LocDlssgMaxFramesTip}">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LocDlssgLogLevelLabel}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource LocDlssgLogLevelDesc}"/>
                                <ComboBox Style="{StaticResource ComboStyle}"
                                          SelectedValue="{Binding Settings.LogLevel, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          ToolTip="{DynamicResource LocDlssgLogLevelTip}">
                                    <ComboBoxItem Content="0"/>
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TextBoxLikeCardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource LocDlssgCardPaths}"/>

                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LocDlssgSourceDirLabel}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource LocDlssgSourceDirDesc}"/>
                            <DockPanel Margin="0,3,0,0">
                                <Button Content="{DynamicResource LocDlssgBtnBrowse}" Width="50" Margin="0,0,6,0"
                                        Command="{Binding BrowseSourceDirectoryCommand}"
                                        ToolTip="{DynamicResource LocDlssgBtnBrowseTip}"/>
                                <TextBox Style="{StaticResource PlaceholderTextBox}"
                                         Text="{Binding Settings.SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource LocDlssgPathPlaceholder}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource SettingDesc}" Margin="0,3,0,0"
                                       Text="{DynamicResource LocDlssgSourceDllHelp}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Margin="0,3,0,0"
                                       Text="{DynamicResource LocDlssgSourceIniHelp}"/>
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LocDlssgDllLabel}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource LocDlssgDllDesc}"/>
                            <ComboBox Style="{StaticResource ComboStyle}"
                                      SelectedValue="{Binding Settings.DllFileName, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content"
                                      IsEditable="False"
                                      ToolTip="{DynamicResource LocDlssgDllTip}">
                                <ComboBoxItem Content="version.dll"/>
                                <ComboBoxItem Content="dinput8.dll"/>
                                <ComboBoxItem Content="dxgi.dll"/>
                                <ComboBoxItem Content="dbghelp.dll"/>
                                <ComboBoxItem Content="d3d12.dll"/>
                                <ComboBoxItem Content="winmm.dll"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource SettingDesc}" Margin="0,3,0,0"
                                       Text="{DynamicResource LocDlssgDllHelp}"/>
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LocDlssgIniLabel}"/>
                            <TextBlock Style="{StaticResource SettingDesc}" Text="{DynamicResource LocDlssgIniDesc}"/>
                            <ComboBox Style="{StaticResource ComboStyle}"
                                      SelectedValue="{Binding Settings.IniFileName, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content"
                                      IsEditable="False"
                                      ToolTip="{DynamicResource LocDlssgIniTip}">
                                <ComboBoxItem Content="dlssg_sm86.ini"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource SettingDesc}" Margin="0,3,0,0"
                                       Text="{DynamicResource LocDlssgIniHelp}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
